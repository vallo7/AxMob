; Engine configuration file.
config_version=5

[application]

config/name="AxMob"
config/description="AxMob - ValloGame"
config/version="0.6.0"
config/icon="res://assets/ui/brand/app_icon.png"
run/main_scene="res://scenes/boot/splash.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/quit_on_go_back=false
run/max_fps=60
boot_splash/bg_color=Color(1, 1, 1, 1)
boot_splash/show_image=false
boot_splash/fullsize=false

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
UIManager="*res://scripts/managers/ui_manager.gd"
Haptics="*res://scripts/haptics/haptics.gd"
Diagnostics="*res://scripts/perf/diagnostics.gd"
QualityManager="*res://scripts/perf/quality_manager.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"
SaveManager="*res://scripts/save/save_manager.gd"
SceneLoader="*res://scripts/ui/loading/scene_loader.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=360
window/size/window_height_override=640
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[physics]

common/physics_jitter_fix=0.0
common/physics_interpolation=true
common/max_physics_steps_per_frame=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(1, 1, 1, 1)
anti_aliasing/quality/msaa_3d=0
